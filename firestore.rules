rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserEmail() {
      return request.auth.token.email;
    }

    function callerMembershipId(accountId) {
      return accountId + '_' + request.auth.uid;
    }

    function hasMembership(accountId) {
      return exists(/databases/$(database)/documents/accountMemberships/$(callerMembershipId(accountId)));
    }

    function membershipData(accountId) {
      return get(/databases/$(database)/documents/accountMemberships/$(callerMembershipId(accountId))).data;
    }

    function callerUserDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function callerUserDocExists() {
      return exists(callerUserDocPath());
    }

    function callerUserData() {
      return get(callerUserDocPath()).data;
    }

    function hasLegacyAccountLink(accountId) {
      return isAuthenticated() &&
        callerUserDocExists() &&
        (
          request.auth.uid == accountId ||
          (
            ('accountId' in callerUserData()) &&
            callerUserData().accountId == accountId
          )
        );
    }

    function hasLegacyManageRole(accountId) {
      return hasLegacyAccountLink(accountId) &&
        !((('isTeamMemberAccount' in callerUserData()) && callerUserData().isTeamMemberAccount == true)) &&
        (
          (('isAccountOwner' in callerUserData()) && callerUserData().isAccountOwner == true) ||
          (('role' in callerUserData()) && ['admin', 'property_manager', 'assistant_manager'].hasAny([callerUserData().role]))
        );
    }

    function isActiveMember(accountId) {
      return isAuthenticated() &&
        hasMembership(accountId) &&
        (
          !('status' in membershipData(accountId)) ||
          membershipData(accountId).status == 'active'
        );
    }

    function hasAnyRole(accountId, roles) {
      return isActiveMember(accountId) &&
        membershipData(accountId).roles.hasAny(roles);
    }

    function canReadAccount(accountId) {
      return isActiveMember(accountId) || hasLegacyAccountLink(accountId);
    }

    function canManageAccount(accountId) {
      return hasAnyRole(accountId, ['account_owner', 'admin', 'manager']) ||
        hasLegacyManageRole(accountId);
    }

    function accountOwnerDocPath(accountId) {
      return /databases/$(database)/documents/users/$(accountId);
    }

    function accountOwnerDocExists(accountId) {
      return exists(accountOwnerDocPath(accountId));
    }

    function accountOwnerData(accountId) {
      return get(accountOwnerDocPath(accountId)).data;
    }

    function familyAccountDocPath(accountId) {
      return /databases/$(database)/documents/familyAccounts/$(accountId);
    }

    function familyAccountExists(accountId) {
      return exists(familyAccountDocPath(accountId));
    }

    function familyAccountData(accountId) {
      return get(familyAccountDocPath(accountId)).data;
    }

    function familyAccountDataAfter(accountId) {
      return getAfter(familyAccountDocPath(accountId)).data;
    }

    function currentPropertyCount(accountId) {
      return familyAccountExists(accountId) && ('propertyCount' in familyAccountData(accountId))
        ? familyAccountData(accountId).propertyCount
        : 0;
    }

    function currentDeviceCount(accountId) {
      return familyAccountExists(accountId) && ('deviceCount' in familyAccountData(accountId))
        ? familyAccountData(accountId).deviceCount
        : 0;
    }

    function maxPropertiesForPlan(plan) {
      return (plan == 'home' || plan == 'homeowner')
        ? 1
        : ((plan == 'property' || plan == 'basic')
          ? 3
          : ((plan == 'portfolio' || plan == 'professional') ? 15 : 0));
    }

    function maxDevicesForPlan(plan) {
      return (plan == 'home' || plan == 'homeowner')
        ? 8
        : ((plan == 'property' || plan == 'basic' || plan == 'portfolio' || plan == 'professional')
          ? 999
          : 0);
    }

    function maxPropertiesForAccount(accountId) {
      return maxPropertiesForPlan(accountOwnerData(accountId).subscription.plan);
    }

    function maxDevicesForAccount(accountId) {
      return maxDevicesForPlan(accountOwnerData(accountId).subscription.plan);
    }

    function hasPropertyCounterCreateIncrement(accountId) {
      return familyAccountExists(accountId) &&
        familyAccountDataAfter(accountId).propertyCount == currentPropertyCount(accountId) + 1 &&
        familyAccountDataAfter(accountId).propertyCount <= maxPropertiesForAccount(accountId);
    }

    function hasPropertyCounterDeleteDecrement(accountId) {
      return familyAccountExists(accountId) &&
        familyAccountDataAfter(accountId).propertyCount == (currentPropertyCount(accountId) > 0
          ? currentPropertyCount(accountId) - 1
          : 0);
    }

    function hasDeviceCounterCreateIncrement(accountId) {
      return familyAccountExists(accountId) &&
        familyAccountDataAfter(accountId).deviceCount == currentDeviceCount(accountId) + 1 &&
        familyAccountDataAfter(accountId).deviceCount <= maxDevicesForAccount(accountId);
    }

    function hasDeviceCounterDeleteDecrement(accountId) {
      return familyAccountExists(accountId) &&
        familyAccountDataAfter(accountId).deviceCount == (currentDeviceCount(accountId) > 0
          ? currentDeviceCount(accountId) - 1
          : 0);
    }

    function hasActiveManagedInvitePlan(accountId) {
      return accountOwnerDocExists(accountId) &&
        ('subscription' in accountOwnerData(accountId)) &&
        (
          accountOwnerData(accountId).subscription.status == 'active' ||
          (
            accountOwnerData(accountId).subscription.status == 'trial' &&
            (
              !('trialEndsAt' in accountOwnerData(accountId).subscription) ||
              accountOwnerData(accountId).subscription.trialEndsAt == null ||
              accountOwnerData(accountId).subscription.trialEndsAt > (request.time.toMillis() / 1000)
            )
          )
        ) &&
        ['property', 'portfolio'].hasAny([accountOwnerData(accountId).subscription.plan]);
    }

    function hasActiveCoreSubscription(accountId) {
      return accountOwnerDocExists(accountId) &&
        ('subscription' in accountOwnerData(accountId)) &&
        (
          accountOwnerData(accountId).subscription.status == 'active' ||
          (
            accountOwnerData(accountId).subscription.status == 'trial' &&
            (
              !('trialEndsAt' in accountOwnerData(accountId).subscription) ||
              accountOwnerData(accountId).subscription.trialEndsAt == null ||
              accountOwnerData(accountId).subscription.trialEndsAt > (request.time.toMillis() / 1000)
            )
          )
        );
    }

    function hasCorePlanForResources(accountId) {
      return hasActiveCoreSubscription(accountId) &&
        ['home', 'property', 'portfolio', 'homeowner', 'basic', 'professional']
          .hasAny([accountOwnerData(accountId).subscription.plan]);
    }

    function isAccountOwnerOrAdmin(accountId) {
      return canManageAccount(accountId);
    }

    function canManageFamilyMemberRole(userId) {
      return isAuthenticated() &&
        userId != request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        canManageAccount(get(/databases/$(database)/documents/users/$(userId)).data.accountId) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['role', 'updatedAt']);
    }

    // Family membership helper for read-only access paths.
    function isFamilyMember(accountId) {
      return isAuthenticated() &&
        (
          request.auth.uid == accountId ||
          get(/databases/$(database)/documents/familyAccounts/$(accountId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/familyAccounts/$(accountId)).data.memberIds
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) || canManageFamilyMemberRole(userId);
      allow delete: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }

    match /propertyGroups/{groupId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId);
      allow update, delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
    }

    match /properties/{propertyId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId) &&
        hasCorePlanForResources(request.resource.data.accountId) &&
        currentPropertyCount(request.resource.data.accountId) < maxPropertiesForAccount(request.resource.data.accountId) &&
        hasPropertyCounterCreateIncrement(request.resource.data.accountId);
      allow update: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
      allow delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId) &&
        hasPropertyCounterDeleteDecrement(resource.data.accountId);
    }

    match /propertyGroupMemberships/{membershipId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId);
      allow update, delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
    }

    match /propertyShares/{shareId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.sharedWithUserId == request.auth.uid ||
        resource.data.sharedWithEmail == getUserEmail()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        isAccountOwnerOrAdmin(request.resource.data.ownerId)
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isAccountOwnerOrAdmin(resource.data.ownerId)
      );
    }

    match /userInvitations/{invitationId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toEmail == getUserEmail()
      );
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.fromUserId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.fromUserId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId);
      allow update, delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
    }

    match /maintenanceHistory/{historyId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId);
      allow update, delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
    }

    match /maintenanceEvents/{eventId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId);
      allow update, delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
    }

    match /teamGroups/{groupId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId);
      allow update, delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
    }

    match /teamMembers/{memberId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId);
      allow update, delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
    }

    match /devices/{deviceId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId) &&
        hasCorePlanForResources(request.resource.data.accountId) &&
        currentDeviceCount(request.resource.data.accountId) < maxDevicesForAccount(request.resource.data.accountId) &&
        hasDeviceCounterCreateIncrement(request.resource.data.accountId);
      allow update: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
      allow delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId) &&
        hasDeviceCounterDeleteDecrement(resource.data.accountId);
    }

    match /suites/{suiteId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId);
      allow update, delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
    }

    match /units/{unitId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId);
      allow update, delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
    }

    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /contractors/{contractorId} {
      allow read: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canReadAccount(resource.data.accountId);
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId);
      allow update, delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
    }

    // Family account records: client read-only for members/owners.
    // Counter updates are allowed only for account managers and only with
    // tightly constrained field changes.
    match /familyAccounts/{accountId} {
      allow read: if canReadAccount(accountId);
      allow create, delete: if false;
      allow update: if isAuthenticated() &&
        canManageAccount(accountId) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'propertyCount',
          'deviceCount',
          'updatedAt'
        ]) &&
        request.resource.data.propertyCount >= 0 &&
        request.resource.data.deviceCount >= 0 &&
        (
          // Property create increment
          (
            request.resource.data.propertyCount == (('propertyCount' in resource.data) ? resource.data.propertyCount : 0) + 1 &&
            request.resource.data.deviceCount == (('deviceCount' in resource.data) ? resource.data.deviceCount : 0)
          ) ||
          // Property delete decrement
          (
            request.resource.data.propertyCount == ((('propertyCount' in resource.data) ? resource.data.propertyCount : 0) > 0 ? (('propertyCount' in resource.data) ? resource.data.propertyCount : 0) - 1 : 0) &&
            request.resource.data.deviceCount == (('deviceCount' in resource.data) ? resource.data.deviceCount : 0)
          ) ||
          // Device create increment
          (
            request.resource.data.deviceCount == (('deviceCount' in resource.data) ? resource.data.deviceCount : 0) + 1 &&
            request.resource.data.propertyCount == (('propertyCount' in resource.data) ? resource.data.propertyCount : 0)
          ) ||
          // Device delete decrement
          (
            request.resource.data.deviceCount == ((('deviceCount' in resource.data) ? resource.data.deviceCount : 0) > 0 ? (('deviceCount' in resource.data) ? resource.data.deviceCount : 0) - 1 : 0) &&
            request.resource.data.propertyCount == (('propertyCount' in resource.data) ? resource.data.propertyCount : 0)
          )
        );
    }

    match /accountMemberships/{membershipId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        hasAnyRole(resource.data.accountId, ['account_owner', 'admin'])
      );
      allow create, update, delete: if false;
    }

    // Family invites are function-managed only (list/revoke/resend/accept via callable).
    match /familyInvites/{inviteId} {
      allow read, write: if false;
    }

    match /tenantInvitationCodes/{codeId} {
      allow read: if isAuthenticated() && (
        ('accountId' in resource.data && canReadAccount(resource.data.accountId)) ||
        (('tenantEmail' in resource.data) && resource.data.tenantEmail == getUserEmail()) ||
        (('email' in resource.data) && resource.data.email == getUserEmail())
      );
      allow create, update, delete: if false;
    }

    match /tenantProfiles/{profileId} {
      allow read: if isAuthenticated() && (
        ('accountId' in resource.data && canReadAccount(resource.data.accountId)) ||
        resource.data.tenantId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        ('accountId' in request.resource.data) &&
        canManageAccount(request.resource.data.accountId);
      allow update, delete: if isAuthenticated() &&
        ('accountId' in resource.data) &&
        canManageAccount(resource.data.accountId);
    }

    match /teamMemberInvitationCodes/{codeId} {
      allow read: if isAuthenticated() && (
        (('accountId' in resource.data) && canReadAccount(resource.data.accountId)) ||
        (('createdBy' in resource.data) && resource.data.createdBy == request.auth.uid) ||
        (('createdByUserId' in resource.data) && resource.data.createdByUserId == request.auth.uid) ||
        (('teamMemberEmail' in resource.data) && resource.data.teamMemberEmail == getUserEmail()) ||
        (('email' in resource.data) && resource.data.email == getUserEmail())
      );
      allow create, update, delete: if false;
    }

    match /appConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
