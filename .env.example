# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase credentials

REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_WEB_PUSH_VAPID_KEY=your_web_push_vapid_key

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:3001/api

# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys (use test keys for development)
# Price IDs come from Stripe Products > Pricing.
REACT_APP_STRIPE_PUBLIC_KEY=your_stripe_test_public_key_here
REACT_APP_STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/your_portal_link
REACT_APP_STRIPE_FREE_PRICE_ID=price_free_test_id
REACT_APP_STRIPE_HOME_MONTHLY_PRICE_ID=price_home_monthly_test_id
REACT_APP_STRIPE_HOME_ANNUAL_PRICE_ID=price_home_annual_test_id
REACT_APP_STRIPE_HOMEOWNER_PLUS_MONTHLY_PRICE_ID=price_homeowner_plus_monthly_test_id
REACT_APP_STRIPE_HOMEOWNER_PLUS_ANNUAL_PRICE_ID=price_homeowner_plus_annual_test_id
REACT_APP_STRIPE_MULTI_HOMEOWNER_MONTHLY_PRICE_ID=price_multi_homeowner_monthly_test_id
REACT_APP_STRIPE_MULTI_HOMEOWNER_ANNUAL_PRICE_ID=price_multi_homeowner_annual_test_id
REACT_APP_ENABLE_MULTI_HOMEOWNER_PLAN=false
REACT_APP_ENABLE_HOMEOWNER_PLUS_PRODUCT_TRIAL=false
REACT_APP_ENABLE_TRUSTED_SETUP_PLAN_ACTIVATION=false
REACT_APP_ENABLE_INTERNAL_ENTITLEMENT_GRANT_ISSUANCE=false
REACT_APP_STRIPE_PROPERTY_MONTHLY_PRICE_ID=price_property_monthly_test_id
REACT_APP_STRIPE_PROPERTY_ANNUAL_PRICE_ID=price_property_annual_test_id
REACT_APP_STRIPE_PORTFOLIO_MONTHLY_PRICE_ID=price_portfolio_monthly_test_id
REACT_APP_STRIPE_PORTFOLIO_ANNUAL_PRICE_ID=price_portfolio_annual_test_id

# Server-owned Stripe price catalog (Firebase Functions)
STRIPE_MULTI_HOMEOWNER_MONTHLY_PRICE_ID=price_multi_homeowner_monthly_test_id
STRIPE_MULTI_HOMEOWNER_ANNUAL_PRICE_ID=price_multi_homeowner_annual_test_id
ENABLE_MULTI_HOMEOWNER_PLAN=false
ENABLE_HOMEOWNER_PLUS_PRODUCT_TRIAL=false
ENABLE_INTERNAL_ENTITLEMENT_GRANT_ISSUANCE=false
ENABLE_ACCESS_LIFECYCLE_COMMUNICATION=false
HOMEOWNER_PLUS_TRIAL_ELIGIBILITY_START_AT=2026-01-01T00:00:00.000Z
APP_ROUTER_MODE=hash

# Android Release Build Configuration
# Used by build-signed-apk.sh for automated APK signing
# Leave empty to prompt during build, or set for non-interactive builds
KEYSTORE_PASSWORD=your_keystore_password_here
KEYSTORE_KEY_PASSWORD=your_key_password_here

# Promo Codes (for testing)
# Set these to enable special promo codes for testing different subscription states
REACT_APP_UNLIMITED_TRIAL_PROMO_CODE=your_unlimited_trial_code
REACT_APP_EXPIRED_TRIAL_PROMO_CODE=your_expired_trial_code

# E2E Demo Account (for non-user-creating test flows)
E2E_DEMO_EMAIL=demo.user@example.com
E2E_DEMO_PASSWORD=your_demo_password_here
