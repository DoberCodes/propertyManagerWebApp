{
	"name": "Maintley",
	"version": "2.7.21",
	"private": true,
	"type": "module",
	"homepage": "./",
	"dependencies": {
		"@capacitor/android": "^8.4.1",
		"@capacitor/app": "^8.1.0",
		"@capacitor/browser": "^8.0.3",
		"@capacitor/cli": "^8.4.1",
		"@capacitor/core": "^8.4.1",
		"@capacitor/geolocation": "^8.2.0",
		"@capacitor/push-notifications": "^8.1.1",
		"@fortawesome/fontawesome-svg-core": "^6.5.1",
		"@fortawesome/free-brands-svg-icons": "^6.5.1",
		"@fortawesome/free-regular-svg-icons": "^6.5.1",
		"@fortawesome/free-solid-svg-icons": "^6.5.1",
		"@fortawesome/react-fontawesome": "^0.2.0",
		"@octokit/rest": "^22.0.1",
		"@reduxjs/toolkit": "^1.9.7",
		"@stripe/stripe-js": "^8.7.0",
		"@testing-library/jest-dom": "^6.1.5",
		"@testing-library/react": "^14.1.2",
		"@testing-library/user-event": "^14.5.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^20.10.5",
		"@types/styled-components": "^5.1.34",
		"@typescript-eslint/eslint-plugin": "^6.17.0",
		"@zxing/library": "0.22.0",
		"axios": "^1.18.1",
		"firebase": "^12.15.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-hash-link": "^1.0.2",
		"react-is": "^18.2.0",
		"react-redux": "^8.1.3",
		"react-router-dom": "^6.21.0",
		"react-router-hash-link": "^2.4.3",
		"react-scripts": "5.0.1",
		"recharts": "^3.9.1",
		"redux": "^4.2.1",
		"redux-thunk": "^2.4.2",
		"styled-components": "^6.4.3",
		"tesseract.js": "^7.0.0",
		"typescript": "^5.3.3",
		"web-vitals": "^2.1.4"
	},
	"scripts": {
		"start": "node ./node_modules/react-scripts/bin/react-scripts.js start",
		"build": "node ./node_modules/react-scripts/bin/react-scripts.js build",
		"lint": "eslint 'src/**/*.{ts,tsx}'",
		"test": "node ./node_modules/react-scripts/bin/react-scripts.js test",
		"test:ci": "node ./node_modules/react-scripts/bin/react-scripts.js test --watchAll=false --passWithNoTests",
		"analyze:bundle": "node scripts/reportBuildAssets.cjs",
		"analyze:media": "node scripts/reportMediaAssets.cjs",
		"check:asset-budgets": "node scripts/checkAssetBudgets.cjs",
		"audit:scripts": "node scripts/auditScripts.cjs",
		"audit:decisions": "node scripts/auditDecisions.cjs",
		"adr:author": "node scripts/promoteAdrCandidates.cjs --author",
		"adr:promote": "node scripts/promoteAdrCandidates.cjs --promote",
		"adr:promote:dry-run": "node scripts/promoteAdrCandidates.cjs --promote --dry-run",
		"adr:trackers:sync": "node scripts/syncAdrImplementationTrackers.cjs",
		"adr:trackers:dry-run": "node scripts/syncAdrImplementationTrackers.cjs --all --dry-run",
		"test:build": "yarn validate",
		"validate": "yarn test:ci && yarn build",
		"e2e": "node ./node_modules/@playwright/test/cli.js test",
		"e2e:smoke:chrome": "node ./node_modules/@playwright/test/cli.js test e2e/auth.spec.ts e2e/support.spec.ts --project=chromium",
		"e2e:workflows:chrome": "node ./node_modules/@playwright/test/cli.js test e2e/auth.spec.ts e2e/property.spec.ts e2e/task.spec.ts e2e/account-rbac.spec.ts --project=chromium",
		"e2e:full-safe": "node ./node_modules/@playwright/test/cli.js test e2e/auth.spec.ts e2e/property.spec.ts e2e/task.spec.ts e2e/journey.spec.ts e2e/account-rbac.spec.ts --project=chromium --project=firefox --project=webkit --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",
		"e2e:ui": "node ./node_modules/@playwright/test/cli.js test --ui",
		"e2e:debug": "node ./node_modules/@playwright/test/cli.js test --debug",
		"e2e:chrome": "node ./node_modules/@playwright/test/cli.js test --project=chromium",
		"e2e:firefox": "node ./node_modules/@playwright/test/cli.js test --project=firefox",
		"e2e:webkit": "node ./node_modules/@playwright/test/cli.js test --project=webkit",
		"e2e:report": "node ./node_modules/playwright/cli.js show-report",
		"e2e:clean": "node -e \"const fs=require('fs');['test-results','playwright-report','.auth'].forEach((p)=>fs.rmSync(p,{recursive:true,force:true}));\"",
		"e2e:full": "node ./node_modules/@playwright/test/cli.js test && yarn e2e:clean",
		"e2e:ci": "node ./node_modules/@playwright/test/cli.js test && yarn e2e:clean && node scripts/cleanupFirebaseTestUsers.cjs --include-demo-artifacts",
		"cleanup:test-data": "node scripts/cleanupFirebaseTestUsers.cjs",
		"cleanup:test-data:dry-run": "node scripts/cleanupFirebaseTestUsers.cjs --dry-run",
		"cleanup:test-data:full": "node scripts/cleanupFirebaseTestUsers.cjs --include-demo-artifacts",
		"cleanup:optional-groups:dry-run": "node scripts/cleanupOptionalGroupLinks.cjs",
		"cleanup:optional-groups:apply": "node scripts/cleanupOptionalGroupLinks.cjs --apply",
		"cleanup:shared-properties:dry-run": "node scripts/cleanupSharedPropertiesData.cjs",
		"cleanup:shared-properties:apply": "node scripts/cleanupSharedPropertiesData.cjs --apply",
		"eject": "node ./node_modules/react-scripts/bin/react-scripts.js eject",
		"predeploy": "npm run build && npm run check:asset-budgets",
		"deploy": "gh-pages -d build",
		"deploy:gh-pages": "gh-pages -d build",
		"seed:firebase": "node scripts/seedFirestore.cjs",
		"seed:demo-account": "node scripts/seedDemoAccount.cjs",
		"support:updates": "node scripts/updateSupportUpdates.cjs",
		"support:updates:dry-run": "node scripts/updateSupportUpdates.cjs --dry-run",
		"migrate:property-memberships": "node scripts/migratePropertyGroupMemberships.cjs",
		"migrate:property-memberships:apply": "node scripts/migratePropertyGroupMemberships.cjs --apply",
		"migrate:property-memberships:cleanup": "node scripts/migratePropertyGroupMemberships.cjs --apply --cleanup-orphans",
		"migrate:report-account-integrity": "node scripts/migrateFixReportAccountIntegrity.cjs",
		"migrate:report-account-integrity:apply": "node scripts/migrateFixReportAccountIntegrity.cjs --apply",
		"migrate:feedback-ticket-numbers": "node scripts/migrateFeedbackTicketNumbers.cjs",
		"migrate:feedback-ticket-numbers:apply": "node scripts/migrateFeedbackTicketNumbers.cjs --apply",
		"migrate:maintenance-events": "node scripts/migrateMaintenanceHistoryToEvents.cjs",
		"migrate:maintenance-events:apply": "node scripts/migrateMaintenanceHistoryToEvents.cjs --apply",
		"migrate:orphaned-data": "node scripts/migrateRemoveOrphanedData.cjs",
		"migrate:orphaned-data:apply": "node scripts/migrateRemoveOrphanedData.cjs --apply",
		"migrate:prune-inactive-user-data": "node scripts/migratePruneInactiveUserData.cjs",
		"migrate:prune-inactive-user-data:apply": "node scripts/migratePruneInactiveUserData.cjs --apply",
		"init:firestore": "node scripts/initFirestore.cjs",
		"test:rules": "node ./node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --only firestore \"node scripts/testFirestoreRules.cjs\"",
		"test:rules:structure": "node scripts/testFirebaseRules.cjs",
		"test:storage": "node ./node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --only firestore,storage \"node scripts/testStorageRules.cjs\"",
		"test:rules:all": "yarn test:rules && yarn test:storage",
		"cap:sync": "yarn build && npx cap sync android",
		"cap:open": "npx cap open android",
		"build:apk": "node scripts/initAppVersion.cjs && yarn build && npx cap sync android",
		"version:init": "node scripts/initAppVersion.cjs",
		"version:update": "node scripts/updateAppVersion.cjs",
		"version:prepare": "node scripts/prepareReleaseVersion.cjs",
		"version:publish": "node scripts/publishAppVersion.cjs",
		"version:validate": "node scripts/validateReleaseVersion.cjs",
		"version:sync": "node scripts/syncAppVersion.cjs",
		"build:signed": "bash build-signed-apk.sh",
		"release:notes": "node scripts/generateReleaseNotes.cjs",
		"release:notes:preview": "node scripts/generateReleaseNotes.cjs --output tmp/release-notes.customer.md --engineering-output tmp/release-notes.engineering.md --metadata-output tmp/release-notes.json",
		"testDeploy": "bash build-signed-apk.sh --dry-run",
		"test:stripe:sandbox": "npm --prefix functions run test:sandbox",
		"test:stripe:cards:sandbox": "npm --prefix functions run test:cards:sandbox",
		"test:stripe:e2e": "node ./node_modules/@playwright/test/cli.js test e2e/payment.spec.ts e2e/stripe-hosted-checkout.spec.ts --project=chromium",
		"test:stripe:webhook:sandbox": "npm --prefix functions run test:webhook:sandbox",
		"test:stripe:all": "yarn test:stripe:sandbox && yarn test:stripe:cards:sandbox && yarn test:stripe:webhook:sandbox && yarn test:stripe:e2e"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"overrides": {
		"typescript": "^5.3.3"
	},
	"devDependencies": {
		"@babel/plugin-proposal-private-property-in-object": "^7.21.11",
		"@capacitor/assets": "^3.0.5",
		"@firebase/rules-unit-testing": "^5.0.1",
		"@playwright/test": "^1.61.1",
		"@types/babel__helper-module-imports": "^7",
		"@types/node-fetch": "^2.6.13",
		"@types/react-is": "^18",
		"@typescript-eslint/parser": "^6.17.0",
		"dotenv": "^17.2.3",
		"firebase-admin": "^13.6.0",
		"firebase-tools": "^15.22.3",
		"gh-pages": "^6.1.1",
		"node-fetch": "^3.3.2",
		"sharp": "^0.34.5",
		"ts-node": "^10.9.2"
	}
}
